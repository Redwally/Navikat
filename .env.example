# Server Configuration
HOST_PORT=3001

# Enable if running behind a reverse proxy or tunnel (nginx, Cloudflare Tunnel, Traefik, etc.) —
# only needed if you have login issues or session problems through a proxy/tunnel. Test with false first.
TRUST_PROXY=false

# Path to Navidrome Music Library directory (fixed internal container path)
MUSIC_LIBRARY_PATH=/music

# Max concurrent downloads in queue (default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Spotify API Credentials (Optional: required only for Spotify search/import)
# Get credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Authentication Settings (Optional)
ENABLE_AUTH=false
AUTH_PASSWORD=secretpassword
SESSION_SECRET=super-secret-key-change-me

# Navidrome Subsonic Integration (Optional: for library scan & playlist creation)
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=adminpassword

# Real host path to your music library (set this to your actual folder on the server)
MUSIC_HOST_PATH=/home/lucas/navidrome/music

# Verbose debug logging (default: false)
DEBUG=false