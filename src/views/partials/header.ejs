<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title>Navikat — Music Fetcher for Navidrome</title>
  
  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#dfe4ec" id="meta-theme-color">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Navikat">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    (function() {
      try {
        var theme = localStorage.getItem('navikat_theme');
        if (theme === 'liquid-glass') {
          document.documentElement.setAttribute('data-theme', 'liquid-glass');
        }
      } catch(e) {}
    })();
  </script>
</head>
<body>
  <header class="app-header">
    <div class="header-container">
      <div class="brand">
        <img src="/images/logo.svg" alt="Navikat" class="brand-logo">
        <span class="brand-subtitle">Music Fetcher for Navidrome</span>
      </div>
      <div class="header-actions">
        <button id="pwa-install-btn" class="btn btn-sm pwa-install-btn" type="button" style="display: none;" title="Install Navikat App">
          📲 Install App
        </button>
        <button id="theme-toggle-btn" class="theme-toggle-btn" type="button" aria-label="Toggle visual theme" title="Switch between Brutalist and Liquid Glass themes">
          <span class="theme-toggle-icon">🫧</span>
          <span class="theme-toggle-label">Liquid Glass</span>
        </button>
        <% if (locals.enableAuth) { %>
          <a href="/logout" class="btn btn-sm btn-outline header-logout-btn">Log Out</a>
        <% } %>
      </div>
    </div>
  </header>
  <main class="app-main">
